{
  "name": "md-live-preview-min",
  "displayName": "Markdown Live Preview (min)",
  "version": "0.0.1",
  "publisher": "local",
  "engines": { "vscode": "^1.80.0" },
  "main": "./out/extension.js",
  "activationEvents": ["onLanguage:markdown"],
  "contributes": {
    "configuration": {
      "title": "Markdown Live Preview",
      "properties": {
        "mdLivePreview.heading": {
          "type": "object",
          "markdownDescription": "各级标题（h1–h6）的样式。键为 `h1`..`h6`，可用字段：`color`（文本颜色）、`backgroundColor`（背景色）、`bold`、`italic`。颜色留空字符串表示沿用主题默认值。",
          "default": {
            "h1": { "color": "#569CD6", "backgroundColor": "", "bold": true, "italic": false },
            "h2": { "color": "#4EC9B0", "backgroundColor": "", "bold": true, "italic": false },
            "h3": { "color": "#DCDCAA", "backgroundColor": "", "bold": true, "italic": false },
            "h4": { "color": "#C586C0", "backgroundColor": "", "bold": true, "italic": false },
            "h5": { "color": "#CE9178", "backgroundColor": "", "bold": true, "italic": false },
            "h6": { "color": "#9CDCFE", "backgroundColor": "", "bold": true, "italic": false }
          }
        },
        "mdLivePreview.body": {
          "type": "object",
          "markdownDescription": "正文文本的样式（不含标题、代码、引用）。可用字段：`color`、`bold`、`italic`。",
          "default": { "color": "", "bold": false, "italic": false }
        },
        "mdLivePreview.codeInline": {
          "type": "object",
          "markdownDescription": "行内代码的样式。可用字段：`color`、`backgroundColor`、`bold`、`italic`。",
          "default": { "color": "", "backgroundColor": "rgba(128, 128, 128, 0.24)", "bold": false, "italic": false }
        },
        "mdLivePreview.codeBlock": {
          "type": "object",
          "markdownDescription": "围栏代码块的样式。目前只使用 `backgroundColor`（整行背景）。",
          "default": { "backgroundColor": "rgba(128, 128, 128, 0.18)" }
        },
        "mdLivePreview.quote": {
          "type": "object",
          "markdownDescription": "引用块的样式。可用字段：`color`、`backgroundColor`。",
          "default": { "color": "", "backgroundColor": "rgba(128, 128, 128, 0.12)" }
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.4.0"
  }
}